---
import Layout from "../../layouts/Layout.astro";
import {getCollection} from 'astro:content';
import PostCard from "../../components/PostCard.astro";
import {withBase} from "@/lib/utils";

interface Post {
    id: string;
    data: {
        title: string;
        description: string;
        publishDate: Date;
        tags: string[];
        cover: {
            src: ImageMetadata;
            alt?: string;
        };
    };
}

const allPost = (await getCollection('posts'))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title="Blog | Stan" description="Writing about Android tuning and module development." scrollSmooth={false}>
    <header class="pb-16 md:pb-24" data-reveal>
        <p class="label-mono mb-3">Blog</p>
        <h1 class="font-extrabold text-4xl tracking-[-0.03em] md:text-6xl">Notes from the workshop.</h1>
    </header>

    <section aria-label="Blog posts">
        {
            allPost.length > 0 ? (
                allPost.map((post: Post) => (
                        <PostCard
                                id={post.id}
                                title={post.data.title}
                                description={post.data.description}
                                publishDate={post.data.publishDate}
                                tags={post.data.tags}
                                cover={post.data.cover}
                        />
                ))
            ) : (
                <div class="flex flex-col items-center rounded-2xl border border-dashed border-line px-6 py-16 text-center md:py-20" data-reveal>
                    <p class="font-bold text-2xl">No posts yet</p>
                    <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
                        I write occasionally about Android tuning and module development. Until the first
                        post lands, the projects page tells the full story.
                    </p>
                    <a href={withBase('/projects')} class="btn-primary mt-8">Browse projects</a>
                </div>
            )
        }
    </section>
</Layout>
