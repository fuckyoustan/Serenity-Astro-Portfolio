---
import Layout from "../layouts/Layout.astro";
import {withBase} from "../lib/utils";
---

<Layout title="Page not found | Stan" description="The page you are looking for does not exist or may have been moved." scrollSmooth={false}>
    <div class="flex flex-col items-center py-16 text-center md:py-24" data-reveal>
        <p class="font-serif text-[7rem] leading-none tracking-tight md:text-[11rem]">
            4<span class="text-gold">0</span>4
        </p>
        <p class="meta-mono mt-4">Page not found</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
            The page you are looking for may have been moved, or the address is mistyped.
        </p>
        <a href={withBase('/')} class="btn-primary mt-8">Back to home</a>
    </div>
</Layout>
