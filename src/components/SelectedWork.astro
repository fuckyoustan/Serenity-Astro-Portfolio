---
// astro imports
import {getCollection} from "astro:content";

// components imports
import ProjectCard from "./ProjectCard.astro";
import {Icon} from "astro-icon/components";

// lib imports
import {withBase} from "../lib/utils";

const allProjects = (await getCollection('projects'))
    .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const [featured, ...rest] = allProjects;
---

<section class="pb-20 md:pb-28" id="work">
    <div class="mx-auto mb-12 flex max-w-2xl flex-col items-center text-center md:mb-16" data-reveal>
        <p class="label-mono">01 · Selected work</p>
        <h2 class="mt-4 text-balance text-3xl font-extrabold tracking-[-0.03em] md:text-5xl">
            Modules, built and&nbsp;maintained.
        </h2>
        <p class="mt-4 max-w-md text-base leading-relaxed text-muted">
            Open-source Magisk and KernelSU projects, each shaped by real device feedback.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
        {
            featured && (
                <ProjectCard
                        id={featured.id}
                        title={featured.data.title}
                        summary={featured.data.summary}
                        tags={featured.data.tags}
                        cover={featured.data.cover}
                        featured
                        data-reveal
                />
            )
        }

        {
            rest.map((project, i) => (
                <ProjectCard
                    id={project.id}
                    title={project.data.title}
                    summary={project.data.summary}
                    tags={project.data.tags}
                    cover={project.data.cover}
                    data-reveal
                    style={`--reveal-delay: ${((i + 1) % 2) * 90}ms`}
                />
            ))
        }

        <!-- The last grid cell becomes the archive link, balancing the grid -->
        <a href={withBase('/projects')}
           class="card card-hover group flex flex-col justify-between gap-8 p-6"
           data-reveal>
            <p class="meta-mono">Archive</p>
            <div class="flex items-end justify-between gap-4">
                <p class="text-2xl font-bold leading-snug tracking-tight">Every module,<br/> release notes included.</p>
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-all duration-300 group-hover:border-ink group-hover:bg-ink group-hover:text-paper dark:group-hover:border-paper dark:group-hover:bg-paper dark:group-hover:text-[#101315]">
                    <Icon name="arrow-right-up-line" class="h-4 w-4" aria-hidden="true"/>
                </span>
            </div>
        </a>
    </div>
</section>
