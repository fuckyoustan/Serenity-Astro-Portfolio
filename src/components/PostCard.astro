---
import {Image} from "astro:assets";
import {withBase} from "../lib/utils";

interface Props {
    id: string;
    title: string;
    description: string;
    publishDate: Date;
    tags: string[];
    cover: {
        src: ImageMetadata;
        alt?: string;
    };
}

const {id, title, description, publishDate, tags, cover} = Astro.props as Props;
---

<a href={withBase(`/blog/${id}`)} aria-label={`Read post: ${title}`}
   class="group grid grid-cols-1 gap-5 border-t border-line py-8 transition-colors duration-300 last:border-b hover:bg-surface/70 md:grid-cols-[12rem_1fr] md:gap-10 md:py-10">
    <div class="aspect-[16/10] overflow-hidden rounded-md md:aspect-auto md:h-32">
        <Image
                transition:name={`${id}-image`}
                src={cover.src}
                alt={cover.alt ?? `Cover preview of ${title}`}
                class="h-full w-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-[1.05]"
                loading="lazy"
                decoding="async"
                width={320}
        />
    </div>

    <div class="flex min-w-0 flex-col gap-2.5">
        <p class="meta-mono">
            <time datetime={publishDate.toISOString()}>
                {publishDate.toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'})}
            </time>
            <span class="mx-2 text-line" aria-hidden="true">·</span>
            {tags.join(' · ')}
        </p>
        <h2 class="font-serif text-2xl tracking-tight transition-colors duration-300 group-hover:text-gold md:text-3xl">
            {title}
        </h2>
        <p class="max-w-xl text-sm leading-relaxed text-muted">{description}</p>
    </div>
</a>
