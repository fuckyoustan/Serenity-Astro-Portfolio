---
// components imports
import Social from "./Social.astro";

// data imports
import {menu} from "../data/menu";

// lib imports
import {withBase} from "../lib/utils";

// config import
import {SOCIALS, SITE} from '@/config';

const year = new Date().getFullYear();

const externalLinks = SOCIALS.filter((s) => s.show).map((s) => ({
    label: s.name,
    url: s.url,
}));
---

<footer class="px-3 pb-3 md:px-6 md:pb-6">
    <div class="section-shell container px-6 py-10 md:px-10 md:py-12">
        <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
            <div class="flex flex-col items-start gap-4">
                <a href={withBase('/')} class="group flex items-center gap-2.5" aria-label="Stan, back to home">
                    <span class="flex h-8 w-8 items-center justify-center transition-transform duration-300 group-hover:-rotate-[10deg]"
                          aria-hidden="true">
                        <svg class="h-7 w-7" viewBox="0 0 300 300" focusable="false">
                            <path
                                d="M38.294,109.388c0,0,22.771-2.883,22.771,26.215c0,29.098-1.547,141.917,168.292,84.193c0,0-45.12-3.389-63.265-23.863c0,0,42.687-1.746,61.249-60.214C245.904,77.25,270,83.462,270,83.462s-77.435-29.359-114.884,5.898c-37.449,35.256-33.567,37.984-46.541,32.558c-12.973-5.426-20.315-37.41-47.602-34.984C33.686,89.36,38.294,109.388,38.294,109.388z"
                                fill="#F87EA1" stroke="currentColor" stroke-width="8"
                                stroke-linecap="round" stroke-linejoin="round" fill-rule="evenodd"/>
                        </svg>
                    </span>
                    <span class="text-[15px] font-bold tracking-tight">Stan</span>
                </a>
                <p class="max-w-xs text-sm leading-relaxed text-muted">
                    Android modules for rendering, thermal, network, and battery performance.
                    Magisk · KernelSU · Open source.
                </p>
            </div>

            <nav aria-label="Site pages">
                <h3 class="meta-mono mb-4">Pages</h3>
                <ul class="flex flex-col gap-2.5">
                    {
                        menu.map((item) => (
                            <li>
                                <a href={withBase(item.href)}
                                   class="link-line text-sm font-medium text-muted transition-colors duration-200 hover:text-ink">
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <nav aria-label="External links">
                <h3 class="meta-mono mb-4">Elsewhere</h3>
                <ul class="flex flex-col gap-2.5">
                    {
                        externalLinks.map((link) => (
                            <li>
                                <a href={link.url} target="_blank" rel="noopener noreferrer"
                                   class="link-line text-sm font-medium text-muted transition-colors duration-200 hover:text-ink">
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>

        <div class="mt-10 flex flex-col items-center justify-between gap-5 border-t border-line pt-7 md:flex-row">
            <p class="text-[13px] text-muted">© {year} {SITE.author} · Built with Astro</p>
            <Social/>
        </div>
    </div>
</footer>
