---
// data imports
import {menu} from "../data/menu";

// lib imports
import {withBase, normalizePath} from "../lib/utils";

const current = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
    const target = normalizePath(href);
    return target === '/' ? current === '/' : current.startsWith(target);
};
---

<!--
    Floating glass pill header (instafel-style): the nav is a rounded card
    that hovers above the page. Fully transparent is not the resting state;
    it frosts at /80 and deepens to /60 + blur 24px once the page scrolls.
    The header is always fixed and never hides while scrolling.
-->
<header id="site-nav" class="fixed inset-x-0 top-0 z-50 px-4 pt-3 sm:px-6 sm:pt-4">
    <nav class="nav-shell mx-auto flex h-14 max-w-6xl items-center justify-between gap-2 rounded-3xl border border-line pl-5 pr-3"
         aria-label="Main navigation">
        <a href={withBase('/')}
           class="flex items-center gap-2.5 transition-transform duration-200 hover:scale-[1.03]"
           aria-label="Stan, back to home">
            <span class="brand-mark inline-flex shrink-0" aria-hidden="true">
                <svg class="h-7 w-7" viewBox="0 0 300 300" focusable="false">
                    <path
                        d="M38.294,109.388c0,0,22.771-2.883,22.771,26.215c0,29.098-1.547,141.917,168.292,84.193c0,0-45.12-3.389-63.265-23.863c0,0,42.687-1.746,61.249-60.214C245.904,77.25,270,83.462,270,83.462s-77.435-29.359-114.884,5.898c-37.449,35.256-33.567,37.984-46.541,32.558c-12.973-5.426-20.315-37.41-47.602-34.984C33.686,89.36,38.294,109.388,38.294,109.388z"
                        fill="#F87EA1" stroke="currentColor" stroke-width="8"
                        stroke-linecap="round" stroke-linejoin="round" fill-rule="evenodd"/>
                </svg>
            </span>
            <span class="font-serif text-2xl tracking-tight">Stan<span class="text-gold" aria-hidden="true">.</span></span>
        </a>

        <ul class="hidden items-center gap-6 md:flex">
            {
                menu.map((item) => (
                    <li>
                        <a
                            href={withBase(item.href)}
                            aria-current={isActive(item.href) ? 'page' : undefined}
                            class:list={[
                                'link-line font-mono text-xs uppercase tracking-[0.16em] transition-colors duration-200',
                                isActive(item.href) ? 'text-gold' : 'text-muted hover:text-ink',
                            ]}
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
            <li class="h-4 w-px bg-line" aria-hidden="true"></li>
            <li>
                <button
                    type="button"
                    data-theme-toggle
                    aria-label="Switch to dark theme"
                    class="flex h-11 w-11 items-center justify-center rounded-full text-muted transition-colors duration-200 hover:bg-ink/5 hover:text-ink dark:hover:bg-ink/10"
                >
                    <svg class="h-[18px] w-[18px] dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
                    </svg>
                    <svg class="hidden h-[18px] w-[18px] dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                    </svg>
                </button>
            </li>
        </ul>

        <div class="flex items-center gap-1 md:hidden">
            <button
                type="button"
                data-theme-toggle
                aria-label="Switch to dark theme"
                class="flex h-11 w-11 items-center justify-center rounded-full text-muted transition-colors hover:text-ink"
            >
                <svg class="h-[18px] w-[18px] dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
                </svg>
                <svg class="hidden h-[18px] w-[18px] dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                </svg>
            </button>
            <button
                type="button"
                data-menu-toggle
                aria-expanded="false"
                aria-controls="mobile-menu"
                class="flex h-11 w-11 items-center justify-center rounded-full text-ink transition-colors hover:bg-ink/5 dark:hover:bg-ink/10"
            >
                <span class="sr-only">Open main menu</span>
                <svg class="icon-open h-5 w-5" aria-hidden="true" viewBox="0 0 17 14" fill="none" stroke="currentColor"
                     stroke-width="1.6" stroke-linecap="round">
                    <path d="M1 1h15M1 7h15M1 13h15"></path>
                </svg>
                <svg class="icon-close hidden h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <path d="M18 6 6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Mobile menu: floating card below the pill, glass to match -->
    <div id="mobile-menu" class="pt-2 md:hidden">
        <div class="menu-card rounded-3xl border border-line p-2 shadow-xl shadow-black/10">
            <ul class="flex flex-col">
                {
                    menu.map((item) => (
                        <li>
                            <a
                                href={withBase(item.href)}
                                aria-current={isActive(item.href) ? 'page' : undefined}
                                class:list={[
                                    'flex min-h-[48px] items-center rounded-xl px-4 font-mono text-xs uppercase tracking-[0.16em] transition-colors duration-200',
                                    isActive(item.href)
                                        ? 'bg-gold/10 text-gold'
                                        : 'text-muted hover:bg-ink/5 hover:text-ink dark:hover:bg-ink/10',
                                ]}
                            >
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</header>
