---
// data imports
import {menu} from "../data/menu";

// lib imports
import {withBase, normalizePath} from "../lib/utils";

const current = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
    const target = normalizePath(href);
    return target === '/' ? current === '/' : current.startsWith(target);
};
---

<header id="site-nav" class="fixed inset-x-0 z-40 px-3 md:px-6">
    <nav class="nav-shell container flex items-center justify-between rounded-full py-2 pl-4 pr-2" aria-label="Main navigation">
        <a href={withBase('/')} class="group flex items-center gap-2.5" aria-label="Stan, back to home">
            <span class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-ink text-sm font-extrabold tracking-tight text-paper transition-transform duration-300 group-hover:rotate-[10deg] dark:text-[#101315]"
                  aria-hidden="true">S</span>
            <span class="text-[15px] font-bold tracking-tight">Stan</span>
        </a>

        <ul class="hidden items-center gap-1 md:flex">
            {
                menu.map((item) => (
                    <li>
                        <a
                            href={withBase(item.href)}
                            aria-current={isActive(item.href) ? 'page' : undefined}
                            class:list={[
                                'rounded-full px-3.5 py-2 text-sm font-medium transition-colors duration-200',
                                isActive(item.href)
                                    ? 'bg-ink/[0.06] text-ink dark:bg-paper/[0.08]'
                                    : 'text-muted hover:text-ink',
                            ]}
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="flex items-center gap-1">
            <button
                type="button"
                data-theme-toggle
                aria-label="Switch to dark theme"
                class="flex h-10 w-10 items-center justify-center rounded-full text-muted transition-colors duration-200 hover:bg-ink/5 hover:text-ink dark:hover:bg-paper/10 dark:hover:text-paper"
            >
                <svg class="h-[17px] w-[17px] dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
                </svg>
                <svg class="hidden h-[17px] w-[17px] dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                </svg>
            </button>
            <button
                type="button"
                data-menu-toggle
                aria-expanded="false"
                aria-controls="mobile-menu"
                class="flex h-10 w-10 items-center justify-center rounded-full text-ink transition-colors hover:bg-ink/5 md:hidden dark:hover:bg-paper/10"
            >
                <span class="sr-only">Open main menu</span>
                <svg class="icon-open h-5 w-5" aria-hidden="true" viewBox="0 0 17 14" fill="none" stroke="currentColor"
                     stroke-width="1.6" stroke-linecap="round">
                    <path d="M1 1h15M1 7h15M1 13h15"></path>
                </svg>
                <svg class="icon-close hidden h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <path d="M18 6 6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </nav>

    <div id="mobile-menu" class="nav-shell container rounded-3xl md:hidden">
        <ul class="flex flex-col p-2">
            {
                menu.map((item) => (
                    <li>
                        <a
                            href={withBase(item.href)}
                            aria-current={isActive(item.href) ? 'page' : undefined}
                            class:list={[
                                'flex min-h-[48px] items-center rounded-2xl px-4 text-[15px] font-medium transition-colors',
                                isActive(item.href)
                                    ? 'bg-ink/[0.06] text-ink dark:bg-paper/[0.08]'
                                    : 'text-muted hover:text-ink',
                            ]}
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</header>
