---
// lib imports
import {formatDatetime} from "../lib/utils";

interface Edu {
    title: string;
    school: string;
    location: string;
    startDate: string;
    endDate?: string;
    description: string;
    currentUni: boolean;
}

const {eduData} = Astro.props as { eduData: Edu };
const {
    title,
    school,
    location,
    startDate,
    endDate,
    description,
    currentUni,
} = eduData;
---

<div class="relative border-l border-line pb-12 pl-8 last:pb-0">
    <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full border border-ink/30 bg-paper"
          aria-hidden="true"></span>

    <p class="meta-mono">
        {formatDatetime(startDate)} – {currentUni ? 'Present' : formatDatetime(endDate)}
    </p>
    <h3 class="mt-2 font-bold text-2xl tracking-tight">{title}</h3>
    <p class="mt-1 text-sm font-medium text-muted">{school} · {location}</p>
    <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">{description}</p>
</div>
