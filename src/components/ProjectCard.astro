---
// astro imports
import {Image} from "astro:assets";
import {Icon} from "astro-icon/components";

// lib imports
import {withBase} from "../lib/utils";

interface Props extends Record<string, any> {
    id: string;
    title: string;
    summary: string;
    tags: string[];
    cover: ImageMetadata;
    featured?: boolean;
}

const {
    id,
    title,
    summary,
    tags,
    cover,
    featured = false,
    ...rest
} = Astro.props as Props;
---

<div data-tilt={featured ? 4 : 6} class:list={['h-full', featured && 'md:col-span-2']}>
    <a
            href={withBase(`/projects/${id}`)}
            aria-label={`View project: ${title}`}
            class:list={[
                'tilt-inner card card-hover group relative flex h-full flex-col gap-5 p-4',
                featured && 'md:flex-row md:items-stretch md:gap-8 md:p-6',
            ]}
            {...rest}
    >
        <div class="tilt-glare" aria-hidden="true"></div>

        <div
                class:list={[
                    'relative overflow-hidden rounded-xl',
                    featured ? 'aspect-[16/10] md:aspect-auto md:min-h-[280px] md:w-[55%]' : 'aspect-[16/10]',
                ]}
        >
            <Image
                transition:name={`${id}-image`}
                src={cover}
                alt={`Cover preview of ${title}`}
                class="h-full w-full object-cover transition-transform duration-[700ms] ease-out group-hover:scale-[1.05]"
                loading={featured ? 'eager' : 'lazy'}
                decoding="async"
                width={featured ? 960 : 640}
            />
        </div>

        <div class:list={['tilt-lift-sm flex flex-col gap-3', featured && 'justify-center md:py-6 md:pr-4']}>
            <ul class="flex flex-wrap gap-1.5">
                {tags.slice(0, 3).map((tag) => (
                    <li class="rounded-full border border-line px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-muted">
                        {tag}
                    </li>
                ))}
            </ul>
            <h3 class:list={['font-bold leading-snug tracking-tight', featured ? 'text-3xl md:text-4xl' : 'text-2xl']}>
                {title}
            </h3>
            {featured && <p class="max-w-md text-sm leading-relaxed text-muted">{summary}</p>}
            <span
                class="mt-1 inline-flex -translate-x-1.5 items-center gap-2 text-sm font-semibold text-ink opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100">
                View project <Icon name="arrow-right-up-line" class="h-4 w-4" aria-hidden="true"/>
            </span>
        </div>
    </a>
</div>
