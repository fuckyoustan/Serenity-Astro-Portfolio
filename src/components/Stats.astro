---
// config import
import { ME } from '@/config'

const { profileFacts } = ME
---

<section class="pb-16 md:pb-24" aria-label="Profile in numbers">
    <div class="section-shell grid grid-cols-1 divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0"
         data-reveal>
        {
            profileFacts.map((fact) => (
                <div
                    class="group flex flex-col items-center gap-2 py-10 transition-colors duration-300 sm:py-12"
                >
                    <dd class="text-5xl font-extrabold leading-none tracking-[-0.03em] md:text-[56px]">
                        <span data-count={fact.value}>{fact.value.toLocaleString('en-US')}</span><span
                        class="text-muted transition-colors duration-300 group-hover:text-ink">+</span>
                    </dd>
                    <dt class="meta-mono mt-1.5">{fact.description}</dt>
                </div>
            ))
        }
    </div>
</section>
