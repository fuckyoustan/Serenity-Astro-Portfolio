---
// components imports
import {Icon} from "astro-icon/components";

// data imports
import hardSkills from "@/data/hardSkills";
import softSkills from "@/data/softSkills";
import languages from "@/data/languages";

// config import
import {ME} from '@/config';
---

<section class="pb-20 md:pb-28" id="about">
    <div class="mx-auto mb-12 flex max-w-2xl flex-col items-center text-center md:mb-16" data-reveal>
        <p class="label-mono">02 · About</p>
        <h2 class="mt-4 text-balance text-3xl font-extrabold tracking-[-0.03em] md:text-5xl">
            Self-taught, system-obsessed.
        </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2 md:gap-6">
        <div class="card flex flex-col gap-7 p-7 md:p-8" data-reveal>
            <p class="max-w-md text-base leading-relaxed text-muted">{ME.aboutMe}</p>

            <div class="mt-auto w-full">
                <h3 class="meta-mono mb-3">Languages</h3>
                <ul class="flex flex-col">
                    {
                        languages.map((lang) => (
                            lang.show && (
                                <li class="flex items-baseline justify-between gap-4 border-b border-line py-2.5 text-sm last:border-b-0">
                                    <span class="font-medium">{lang.name}</span>
                                    <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
                                        {lang.level}
                                    </span>
                                </li>
                            )
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="flex flex-col gap-6">
            <div class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2"
                 data-reveal style="--reveal-delay: 90ms">
                {
                    hardSkills.map((skill) => (
                        <div class="group flex items-start gap-4 bg-surface p-5 transition-colors duration-300 hover:bg-mutes">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-line bg-paper transition-transform duration-300 group-hover:scale-110">
                                <Icon name={skill.icon} class="h-5 w-5" aria-hidden="true"/>
                            </span>
                            <div>
                                <h4 class="text-[15px] font-semibold tracking-tight">{skill.name}</h4>
                                <p class="mt-1 text-sm leading-relaxed text-muted">{skill.description}</p>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="card p-5" data-reveal style="--reveal-delay: 160ms">
                <h3 class="meta-mono mb-3.5">Working style</h3>
                <ul class="flex flex-wrap gap-2">
                    {
                        softSkills.map((skill) => (
                            <li class="flex items-center gap-2 rounded-full border border-line px-3.5 py-2 text-xs font-medium text-muted transition-colors duration-200 hover:border-ink/25 hover:text-ink dark:hover:border-paper/25 hover:dark:text-paper">
                                <Icon name={skill.icon} class="h-3.5 w-3.5" aria-hidden="true"/>
                                {skill.name}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
