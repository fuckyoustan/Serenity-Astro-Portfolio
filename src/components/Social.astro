---
// components imports
import {Icon} from "astro-icon/components";

// config import
import {SOCIALS} from '@/config';
---

<ul class="flex items-center gap-1">
    {
        SOCIALS.map((network) =>
            network.show && (
                <li>
                    <a
                        href={network.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${network.name} profile`}
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-transparent text-muted transition-all duration-200 hover:border-line hover:bg-surface hover:text-ink hover:-translate-y-0.5"
                    >
                        <Icon name={network.icon} class="h-[18px] w-[18px]"/>
                    </a>
                </li>
            )
        )
    }
</ul>
