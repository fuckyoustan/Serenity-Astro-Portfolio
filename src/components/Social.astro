---
// components imports
import {Icon} from "astro-icon/components";

// config import
import {SOCIALS} from '@/config';
---

<ul class="flex items-center gap-1">
    {
        SOCIALS.map((network) =>
            network.show && (
                <li>
                    <a
                        href={network.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${network.name} profile`}
                        class="flex h-11 w-11 items-center justify-center rounded-full text-muted transition-colors duration-200 hover:bg-ink/5 hover:text-gold dark:hover:bg-ink/10"
                    >
                        <Icon name={network.icon} class="h-[18px] w-[18px]"/>
                    </a>
                </li>
            )
        )
    }
</ul>
