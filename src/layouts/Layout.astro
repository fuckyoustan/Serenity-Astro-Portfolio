---
import {ClientRouter} from 'astro:transitions';

import '@/styles/globals.css';

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

import {SITE} from '@/config';
import {withBase} from "@/lib/utils";

interface Props {
    title?: string;
    description?: string;
    tags?: string[];
    author?: string;
    imageOg?: string;
    canonicalURL?: URL | string;
    scrollSmooth?: boolean;
}

const {
    title = SITE.title,
    description = SITE.description,
    tags = SITE.tags,
    author = SITE.author,
    imageOg = withBase(SITE.ogImage),
    canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang ?? "en"}>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="generator" content={Astro.generator}/>
    <meta name="msapplication-TileColor" content="#f7f4ee"/>

    <title>{title}</title>
    <meta name="title" content={title}/>
    <meta name="description" content={description}/>
    <meta name="keywords" content={tags.join(', ')}/>
    <meta name="author" content={author}/>
    <link rel="sitemap" href={withBase('/sitemap-index.xml')}/>
    <link rel="icon" href={withBase(SITE.favicon)}/>
    <link rel="canonical" href={canonicalURL}/>

    <!-- Open Graph -->
    <meta property="og:type" content="website"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalURL}/>
    <meta property="og:image" content={imageOg}/>
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image"/>
    <meta property="twitter:url" content={canonicalURL}/>
    <meta property="twitter:title" content={title}/>
    <meta property="twitter:description" content={description}/>
    <meta property="twitter:image" content={imageOg}/>

    <!-- Theme: applied before first paint to avoid a flash of the wrong mode -->
    <script is:inline>
        (() => {
            const stored = localStorage.getItem('theme');
            const dark = stored === 'dark' ||
                (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle('dark', dark);
            document.documentElement.classList.add('js');
        })();
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
        rel="stylesheet"
    />

    <ClientRouter/>
</head>
<body class="flex min-h-screen flex-col bg-paper text-ink">
<a href="#main"
   class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:text-ink">
    Skip to content
</a>
<Navbar/>
<main id="main" class="container flex-grow pt-24 md:pt-32" role="main">
    <slot/>
</main>
<Footer/>

<script>
    // ------------------------------------------------------------------
    // Interaction layer. Delegated listeners survive Astro view
    // transitions; per-page work re-runs on astro:page-load.
    // ------------------------------------------------------------------

    // Theme toggle
    const applyTheme = (dark: boolean) => {
        document.documentElement.classList.toggle('dark', dark);
        document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
            btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        });
    };

    document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
        if (!btn) return;
        const dark = !document.documentElement.classList.contains('dark');
        applyTheme(dark);
        localStorage.setItem('theme', dark ? 'dark' : 'light');
    });

    // Mobile menu
    const closeMenu = () => {
        document.getElementById('mobile-menu')?.classList.remove('open');
        document.body.style.overflow = '';
        const toggle = document.querySelector('[data-menu-toggle]');
        toggle?.classList.remove('menu-open');
        toggle?.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('[data-menu-toggle]')) {
            const menu = document.getElementById('mobile-menu');
            if (!menu) return;
            const open = menu.classList.toggle('open');
            document.body.style.overflow = open ? 'hidden' : '';
            const toggle = document.querySelector('[data-menu-toggle]');
            toggle?.classList.toggle('menu-open', open);
            toggle?.setAttribute('aria-expanded', String(open));
            return;
        }
        // Close the panel after picking any link inside it,
        // or when tapping anywhere outside the header
        if (target.closest('#mobile-menu a') || !target.closest('#site-nav')) closeMenu();
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
    });

    // Navbar: switch to the deep-glass state once the page scrolls.
    // The header stays fixed and visible at all times — it never hides.
    const syncNav = () => {
        document.getElementById('site-nav')?.classList.toggle('is-scrolled', window.scrollY > 10);
    };
    syncNav();
    window.addEventListener('scroll', syncNav, {passive: true});
    document.addEventListener('astro:page-load', syncNav);

    // Back to top
    document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('[data-back-to-top]')) return;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({top: 0, behavior: reduced ? 'auto' : 'smooth'});
    });

    // ------------------------------------------------------------------
    // Per-page: scroll reveals + stat count-up
    // ------------------------------------------------------------------
    const initReveals = () => {
        const els = document.querySelectorAll<HTMLDivElement>(
            '[data-reveal]:not(.is-revealed):not([data-reveal-bound])'
        );
        if (
            window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
            !('IntersectionObserver' in window)
        ) {
            els.forEach((el) => el.classList.add('is-revealed'));
            return;
        }
        const io = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-revealed');
                        io.unobserve(entry.target);
                    }
                }
            },
            {rootMargin: '0px 0px -10% 0px', threshold: 0.05}
        );
        els.forEach((el) => {
            el.setAttribute('data-reveal-bound', '1');
            io.observe(el);
        });
    };

    const initCounters = () => {
        const els = document.querySelectorAll<HTMLElement>('[data-count]:not([data-count-bound])');
        if (!els.length) return;

        const animate = (el: HTMLElement) => {
            const finalValue = Number(el.dataset.count);
            if (!Number.isFinite(finalValue) || finalValue === 0) return;
            el.textContent = '0';
            const startedAt = performance.now();
            const duration = 900;
            const step = (now: number) => {
                const t = Math.min((now - startedAt) / duration, 1);
                const eased = 1 - Math.pow(1 - t, 3);
                el.textContent = Math.round(finalValue * eased).toLocaleString('en-US');
                if (t < 1) requestAnimationFrame(step);
                else el.textContent = finalValue.toLocaleString('en-US');
            };
            requestAnimationFrame(step);
        };

        if (
            window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
            !('IntersectionObserver' in window)
        ) {
            return; // final values are already rendered in the markup
        }

        const io = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        io.unobserve(entry.target);
                        animate(entry.target as HTMLElement);
                    }
                }
            },
            {threshold: 0.4}
        );
        els.forEach((el) => {
            el.setAttribute('data-count-bound', '1');
            io.observe(el);
        });
    };

    const initPage = () => {
        try {
            initReveals();
            initCounters();
        } catch {
            // If anything fails, show all content immediately
            document
                .querySelectorAll('[data-reveal]')
                .forEach((el) => el.classList.add('is-revealed'));
        }
    };

    initPage();
    document.addEventListener('astro:page-load', initPage);
</script>
</body>
</html>
